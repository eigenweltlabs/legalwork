{
  "name": "@eigenweltlabs/legalwork-workspace",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "LEGALWORK_DEV_MODE=1 LEGALWORK_ELECTRON_REMOTE_DEBUG_PORT=${LEGALWORK_ELECTRON_REMOTE_DEBUG_PORT:-9823} pnpm --filter @legalwork/desktop dev",
    "dev:electron": "LEGALWORK_DEV_MODE=1 pnpm --filter @legalwork/desktop dev:electron",
    "dev:electron:two": "LEGALWORK_DEV_MODE=1 node scripts/dev-two-electron-demo.mjs",
    "demo:electron": "LEGALWORK_DEV_MODE=1 node scripts/dev-two-electron-demo.mjs --reset",
    "demo:reset": "node scripts/dev-two-electron-demo.mjs --reset-only",
    "dev:ui": "LEGALWORK_DEV_MODE=1 pnpm --filter @legalwork/app dev",
    "dev:headless-web": "LEGALWORK_DEV_MODE=1 bun scripts/dev-headless-web.ts",
    "build": "node scripts/build.mjs",
    "build:ui": "pnpm --filter @legalwork/app build",
    "build:web": "pnpm --filter @legalwork/app build:web",
    "preview": "pnpm --filter @legalwork/app preview",
    "typecheck": "pnpm --filter @legalwork/app typecheck",
    "test:health": "pnpm --filter @legalwork/app test:health",
    "test:sessions": "pnpm --filter @legalwork/app test:sessions",
    "test:refactor": "pnpm --filter @legalwork/app test:refactor",
    "test:events": "pnpm --filter @legalwork/app test:events",
    "test:todos": "pnpm --filter @legalwork/app test:todos",
    "test:permissions": "pnpm --filter @legalwork/app test:permissions",
    "test:session-error-recovery": "pnpm --filter @legalwork/app test:session-error-recovery",
    "test:session-scope": "pnpm --filter @legalwork/app test:session-scope",
    "test:session-switch": "pnpm --filter @legalwork/app test:session-switch",
    "test:fs-engine": "pnpm --filter @legalwork/app test:fs-engine",
    "test:e2e": "pnpm --filter @legalwork/app test:e2e",
    "test:orchestrator": "pnpm --filter legalwork-orchestrator test:router",
    "release:review": "node scripts/release/review.mjs",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:prepare:dry": "node scripts/release/prepare.mjs --dry-run",
    "release:ship": "node scripts/release/ship.mjs",
    "release:ship:watch": "node scripts/release/ship.mjs --watch",
    "office:sideload": "pnpm --filter @legalwork/desktop office:sideload"
  },
  "packageManager": "pnpm@11.4.0"
}
