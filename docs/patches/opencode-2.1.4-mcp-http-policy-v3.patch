+testEffect(Layer.empty).effect("cancelling an MCP flush releases its reconciliation lock", () =>
+  Effect.gen(function* () {
+    const catalog = yield* Ref.make<Mcp.Tool[]>([])
+    const started = yield* Deferred.make<void>()
+    const held = yield* Deferred.make<void>()
+    let block = false
+    yield* Effect.gen(function* () {
+      const registry = yield* Tool.Service
+      const registration = yield* McpTool.Service
+      yield* registration.flush
+      block = true
+      const waiting = yield* registration.flush.pipe(Effect.forkScoped)
+      yield* Deferred.await(started)
+      // A second admission can be cancelled while the first owns the catalog lock.
+      const queued = yield* registration.flush.pipe(Effect.forkScoped)
+      yield* Effect.yieldNow
+      yield* Fiber.interrupt(queued)
+      const queuedExit = yield* Fiber.await(queued)
+      expect(Exit.isFailure(queuedExit)).toBe(true)
+      yield* Fiber.interrupt(waiting)
+      const waitingExit = yield* Fiber.await(waiting)
+      expect(Exit.isFailure(waitingExit)).toBe(true)
+      block = false
+      yield* Ref.set(catalog, [
+        {
+          server: Mcp.ServerName.make("demo"),
+          name: "after_cancel",
+          codemode: false,
+          inputSchema: { type: "object", properties: {} },
+        },
+      ])
+      yield* registration.flush
+      expect((yield* toolDefinitions(registry)).map((tool) => tool.name)).toEqual(["demo_after_cancel", "execute"])
+    }).pipe(
+      Effect.provide(
+        AppNodeBuilder.build(LayerNode.group([Tool.node, McpTool.node, Bus.node]), [
+          Mcp.node.replace(
+            Layer.mock(Mcp.Service, {
+              tools: () =>
+                Effect.gen(function* () {
+                  if (block) {
+                    yield* Deferred.succeed(started, undefined)
+                    yield* Deferred.await(held)
+                  }
+                  return yield* Ref.get(catalog)
+                }),
+            }),
+          ),
+          Permission.node.replace(Layer.mock(Permission.Service, { assert: () => Effect.void })),
+          Image.node.replace(imagePassthrough),
+        ]),
+      ),
+    )
+  }),
+)
