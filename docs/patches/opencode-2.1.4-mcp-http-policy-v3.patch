+  snapshot.execute({
+    ...identity,
+    call: { type: "tool-call", id, name: "execute", input: { code } },
+    progress: (update) =>
+      Effect.sync(() => {
+        progress.push(update)
+      }),
+  })
+const it = testEffect(AppNodeBuilder.build(LayerNode.group([Tool.node, PluginHooks.node])))
+const respond = (value: string) => ({
+  url: "https://final.invalid/",
+  status: 418,
