+++ b/packages/codemode/test/http-bindings.test.ts
@@ -0,0 +1,46 @@
+import { expect, test } from "bun:test"
+import { CodeMode, Extension, Tool } from "../src/index.js"
+import { Effect, Schema } from "effect"
+
+test("invocation-local extension bindings share one prepared tool inventory", async () => {
+  let rendered = 0
+  const runtime = CodeMode.make({
+    tools: {
+      echo: Tool.make({
+        description: "Echo",
+        input: Schema.Struct({ text: Schema.String }),
+        output: Schema.String,
+        execute: (input) => Effect.succeed(input.text),
+      }),
+    },
+    extensions: [Extension.make({ name: "default", globals: { label: () => "default" } })],
+  })
+  const catalog = runtime.catalog
+  const program = "return await tools.echo({text:label()})"
+  const results = await Promise.all(
+    ["first", "second"].map((text) =>
+      Effect.runPromise(
+        runtime.execute(program, {
+          extensions: [
+            Extension.make({
+              name: "local",
+              globals: {
+                label: () => {
+                  rendered++
+                  return text
+                },
+              },
+            }),
+          ],
+        }),
+      ),
+    ),
+  )
+  expect(results.map((result) => result.ok && result.value)).toEqual(["first", "second"])
+  expect((await Effect.runPromise(runtime.execute(program))).ok).toBe(true)
+  expect(rendered).toBe(2)
+  expect(runtime.catalog).toBe(catalog)
+  expect(() =>
+    runtime.execute(program, { extensions: [Extension.make({ name: "invalid", globals: { URL: () => 1 } })] }),
+  ).toThrow('global "URL" is already defined')
+})
