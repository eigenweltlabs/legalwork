+        yield* registration.flush
+        expect((yield* toolDefinitions(registry)).map((tool) => tool.name)).toEqual(["execute"])
+
+        yield* Ref.set(catalog, [tool("direct", false), tool("search", true, "other")])
+        yield* Effect.forEach(Array.from({ length: 20 }), () =>
+          Effect.forEach(["demo", "other"], (server) => bus.publish(McpEvent.ToolsChanged, { server })),
+        )
+        // An unrelated registry reload cannot stand in for native MCP reconciliation.
+        yield* registry.reload()
+        expect((yield* toolDefinitions(registry)).map((tool) => tool.name)).toEqual(["execute"])
+        yield* registration.flush
+        const first = yield* registry.snapshot()
+        expect(first.definitions.map((tool) => tool.name)).toEqual(["demo_direct", "execute"])
+        expect(first.codeModeCatalog && codeModeListings(first.codeModeCatalog).map((tool) => tool.path)).toEqual([
