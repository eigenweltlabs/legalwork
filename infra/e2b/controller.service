[Unit]
Description=LegalWork per-user microVM controller
After=docker.service google-startup-scripts.service
RequiresMountsFor=/data /opt/e2b

[Service]
Type=simple
WorkingDirectory=/opt/e2b
EnvironmentFile=/opt/e2b/controller.env
ExecStart=/opt/e2b/legalwork-vm-controller
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/controller

[Install]
WantedBy=multi-user.target
