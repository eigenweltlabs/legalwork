#!/bin/busybox sh
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev
/bin/busybox mount -t tmpfs -o size=512m,mode=1777 tmpfs /tmp
/sbin/modprobe virtio_mmio || true
/sbin/modprobe virtio_pci || true
/sbin/modprobe virtio_console
/sbin/modprobe virtio_balloon
/sbin/modprobe fuse
/bin/busybox ip link set lo up
# The host enables a NIC only for the explicitly unrestricted runtime.
# Restricted commands use the framed broker, with no NIC or host mounts.
exec /usr/local/bin/python3 -I -u /opt/legalwork/supervisor.py 2>/dev/console
